# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── Environment variables (never bake secrets into the image) ─────────────────
.env
.env.*
!.env.example         # allow the example template

# ── Django artifacts ──────────────────────────────────────────────────────────
db.sqlite3
staticfiles/
media/

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Tests & CI ────────────────────────────────────────────────────────────────
.github/
.pytest_cache/
htmlcov/
.coverage

# ── Editor / OS ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.DS_Store
Thumbs.db

# ── Docker files themselves (not needed inside the image) ─────────────────────
docker-compose*.yml
Dockerfile*
